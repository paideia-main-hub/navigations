NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin portal (hardcoded credentials, not a Supabase Auth user — see
# domain/admin-auth/). ADMIN_PASSWORD_HASH is a sha256 hex digest, not a
# plaintext password: compute it with
#   node -e "console.log(require('crypto').createHash('sha256').update('yourpassword').digest('hex'))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
