NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin for SEO (canonical URLs, Open Graph, sitemap).
# Example: https://navigations.com.pk
NEXT_PUBLIC_SITE_URL=

# On-site support chat — Groq first, Gemini fallback when Groq is busy.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Optional override (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b
# Optional vision override (default: qwen/qwen3.8-27b)
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Voice transcription model (default: whisper-large-v3, English forced)
# GROQ_WHISPER_MODEL=whisper-large-v3

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional override (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Admins are real Supabase Auth users (profiles.role = 'admin') — there's no
# admin env var to set here. Bootstrap the first one with:
#   npm run seed:admin -- "Full Name" admin@example.com "a strong password"
# Every admin after that is created from inside the panel at /admin/admins.
